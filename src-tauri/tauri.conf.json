{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scan-lun",
  "version": "1.0.4",
  "identifier": "com.scanlun.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "scan-lun",
        "width": 800,
        "height": 600,
        "minWidth": 480,
        "minHeight": 400
      },
      {
        "label": "prompt",
        "title": "每日三省",
        "width": 480,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/xianglun918/scan-lun/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCODI2ODkzN0E4MUE1ODEKUldTQnBZRjZrMmlDbXlnNEUrTWdyQTVmdGFUSkZuVENiU3V2bUFSbFhkQ1hrSmhNWUJRMi9HWTcK"
    }
  }
}
