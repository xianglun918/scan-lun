{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and prompt windows",
  "windows": ["main", "prompt"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:default",
    "updater:default"
  ]
}
